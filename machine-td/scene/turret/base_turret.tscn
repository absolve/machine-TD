[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://script/turret/base_turret.gd" id="1_script"]

[ext_resource type="Texture2D" path="res://sprite/enemy/redesigned/experimental_tank_turret.svg" id="2_turret_tex"]
[sub_resource type="CircleShape2D" id="CircleShape2D_radar"]
radius = 240.0

[sub_resource type="SpriteFrames" id="SpriteFrames_turret"]
animations = [{
"frames": [{
"duration": 1.0,
"texture": ExtResource("2_turret_tex")
}],
"loop": 1,
"name": &"default",
"speed": 5.0
}]

[node name="BaseTurret" type="Node2D"]
script = ExtResource("1_script")

[node name="Turret" type="AnimatedSprite2D" parent="."]
sprite_frames = SubResource("SpriteFrames_turret")
offset = Vector2(6, 0)

[node name="Muzzle" type="Marker2D" parent="Turret"]

[node name="Radar" type="Area2D" parent="."]
collision_layer = 0

[node name="CollisionShape2D" type="CollisionShape2D" parent="Radar"]
shape = SubResource("CircleShape2D_radar")

[node name="Delay" type="Timer" parent="."]
one_shot = true

[connection signal="area_entered" from="Radar" to="." method="onRadarAreaEntered"]
[connection signal="area_exited" from="Radar" to="." method="onRadarAreaExited"]
[connection signal="timeout" from="Delay" to="." method="onDelayTimeout"]
